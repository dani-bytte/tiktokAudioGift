{
  "name": "tiktokaudiogift",
  "private": true,
  "version": "1.0.0",
  "author": "Daniel",
  "description": "TikTok Audio Gift - Play custom audio when receiving TikTok gifts",
  "type": "module",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js --configLoader runner",
    "build": "tsc && bun ./node_modules/vite/bin/vite.js --configLoader runner build && electron-builder --publish never",
    "build:fast": "tsc && bun ./node_modules/vite/bin/vite.js --configLoader runner build && electron-builder --dir --publish never",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "bun ./node_modules/vite/bin/vite.js --configLoader runner preview"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "lucide-react": "^0.575.0",
    "music-metadata": "^11.12.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tiktok-live-connector": "2.3.0-beta1",
    "uuid": "^14.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.24",
    "electron": "^41.5.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "postcss": "^8.5.6",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "main": "dist-electron/main.js",
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "pnpm": {
    "overrides": {
      "ajv-keywords>ajv": "^6.12.6",
      "@develar/schema-utils>ajv": "^6.12.6"
    }
  }
}
